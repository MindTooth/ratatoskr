{
  "name": "ratatoskr-release",
  "private": true,
  "version": "0.0.0-development",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12",
      "onFail": "download"
    }
  },
  "scripts": {
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "15.0.0-beta.3",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "semantic-release": "25.0.9"
  }
}
